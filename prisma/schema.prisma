// ============================================
// Prisma Schema — E-Komite Pintar (SQLite Version)
// Multi-Tenant / SaaS Ready
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// SaaS Models
// ============================================

model Sekolah {
  id                 String   @id @default(uuid())
  nama_sekolah       String
  alamat             String?
  status             String    @default("AKTIF") // AKTIF / NONAKTIF
  paket_berlangganan String    @default("BASIC") // BASIC, PREMIUM, ENTERPRISE
  paket_id           String?
  langganan_berakhir DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  paket             PaketSaaS?        @relation(fields: [paket_id], references: [id], onDelete: SetNull)
  users             User[]
  siswa             Siswa[]
  tagihan           Tagihan[]
  voting            Voting[]
  system_logs       SystemLog[]
  pengeluaran       Pengeluaran[]
  saas_transactions SaaSTransaction[]

  @@index([status])
  @@index([paket_id])
  @@map("sekolah")
}

// ============================================
// Models
// ============================================

model User {
  id            String   @id @default(uuid())
  nama_lengkap  String
  email         String   @unique
  password_hash String
  no_whatsapp   String?
  role          String   @default("ORANG_TUA")
  status        Boolean  @default(true)
  sekolah_id    String? // Nullable karena SUPER_ADMIN tidak terikat sekolah
  fcm_token     String?
  foto_profil   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  sekolah      Sekolah?      @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  siswa        Siswa[]
  tagihan      Tagihan[]
  voting_suara VotingSuara[]
  system_logs  SystemLog[]
  pengeluaran  Pengeluaran[]

  @@index([sekolah_id])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Siswa {
  id           String   @id @default(uuid())
  nama_siswa   String
  nisn         String   @unique
  kelas        String
  orang_tua_id String
  sekolah_id   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  sekolah    Sekolah      @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  orang_tua  User         @relation(fields: [orang_tua_id], references: [id], onDelete: Cascade)
  pembayaran Pembayaran[]

  @@index([sekolah_id])
  @@index([orang_tua_id])
  @@map("siswa")
}

model Tagihan {
  id            String   @id @default(uuid())
  judul         String
  deskripsi     String?
  nominal       Float
  tenggat_waktu DateTime
  admin_id      String
  sekolah_id    String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  sekolah    Sekolah      @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  admin      User         @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  pembayaran Pembayaran[]

  @@index([sekolah_id])
  @@index([tenggat_waktu])
  @@map("tagihan")
}

model Pembayaran {
  id              String    @id @default(uuid())
  tagihan_id      String
  siswa_id        String
  status          String    @default("PENDING")
  metode_bayar    String?
  tanggal_bayar   DateTime?
  payment_token   String?
  nominal_dibayar Float     @default(0)
  nominal_diskon  Float     @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  tagihan Tagihan @relation(fields: [tagihan_id], references: [id], onDelete: Cascade)
  siswa   Siswa   @relation(fields: [siswa_id], references: [id], onDelete: Cascade)

  @@index([siswa_id])
  @@index([tagihan_id])
  @@index([status])
  @@index([tanggal_bayar])
  @@map("pembayaran")
}

// ============================================
// E-Voting Models
// ============================================

model Voting {
  id               String   @id @default(uuid())
  judul            String
  deskripsi        String?
  tanggal_berakhir DateTime
  status           String   @default("AKTIF") // AKTIF / SELESAI
  sekolah_id       String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  sekolah  Sekolah          @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  kandidat VotingKandidat[]
  suara    VotingSuara[]

  @@index([sekolah_id])
  @@index([status])
  @@map("voting")
}

model VotingKandidat {
  id            String   @id @default(uuid())
  voting_id     String
  nama_kandidat String
  created_at    DateTime @default(now())

  voting Voting        @relation(fields: [voting_id], references: [id], onDelete: Cascade)
  suara  VotingSuara[]

  @@index([voting_id])
  @@map("voting_kandidat")
}

model VotingSuara {
  id          String   @id @default(uuid())
  voting_id   String
  kandidat_id String
  user_id     String
  created_at  DateTime @default(now())

  voting   Voting         @relation(fields: [voting_id], references: [id], onDelete: Cascade)
  kandidat VotingKandidat @relation(fields: [kandidat_id], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // 1 User hanya boleh memberikan 1 suara pada 1 voting
  @@unique([voting_id, user_id])
  @@index([kandidat_id])
  @@map("voting_suara")
}

// ============================================
// System Models (SaaS Backend)
// ============================================

model SystemLog {
  id         String   @id @default(uuid())
  user_id    String?
  sekolah_id String?
  action     String
  detail     String?
  created_at DateTime @default(now())

  user    User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  sekolah Sekolah? @relation(fields: [sekolah_id], references: [id], onDelete: SetNull)

  @@index([sekolah_id])
  @@index([user_id])
  @@map("system_log")
}

model PaketSaaS {
  id          String   @id @default(uuid())
  nama_paket  String   @unique
  harga       Float
  durasi      String
  batas_siswa Int      @default(999999)
  status      String   @default("AKTIF") // AKTIF / NONAKTIF
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  sekolah   Sekolah[]
  transaksi SaaSTransaction[]

  @@map("paket_saas")
}

model AppSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("app_setting")
}

model Pengeluaran {
  id         String   @id @default(uuid())
  keterangan String
  nominal    Float
  tanggal    DateTime
  kategori   String
  nota_url   String?
  admin_id   String
  sekolah_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sekolah Sekolah @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  admin   User    @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([sekolah_id])
  @@index([tanggal])
  @@map("pengeluaran")
}

model SaaSTransaction {
  id         String   @id @default(uuid())
  sekolah_id String
  paket_id   String
  nominal    Float
  status        String   @default("PENDING") // PENDING, LUNAS, GAGAL
  payment_token String?
  tanggal       DateTime @default(now())

  sekolah Sekolah   @relation(fields: [sekolah_id], references: [id], onDelete: Cascade)
  paket   PaketSaaS @relation(fields: [paket_id], references: [id], onDelete: Cascade)

  @@index([sekolah_id])
  @@index([status])
  @@index([tanggal])
  @@map("saas_transaction")
}
