# ============================================
# E-Komite Pintar — Environment Variables
# ============================================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/e_komite_pintar?schema=public"

# JWT
JWT_SECRET="ganti-dengan-secret-key-yang-kuat-minimal-32-karakter"
JWT_EXPIRES_IN="7d"

# WhatsApp Gateway (Fonnte)
WA_API_TOKEN="api-token-fonnte-anda"
# WA_API_URL="https://api.fonnte.com/send"

# Payment Webhook
PAYMENT_WEBHOOK_SECRET="rahasia-webhook-payment-gateway-123"

# Cloudinary (untuk upload foto profil)
# Daftar gratis di https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
